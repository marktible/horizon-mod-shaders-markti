/target/
/.upstream/
/.archive/
/.local-test/
__pycache__/
*.py[cod]
/.venv/
/.env
/.env.*
/saves/
/sessions/
/accounts/
/resources/

# Only current public shader packages and source-only native mod bundles belong in dist.
/dist/*
!/dist/Markti Shader.zip
!/dist/Markti Shaders Ultra Performance.zip
!/dist/markti_shaders.hshader
!/dist/markti_shaders_ultra.hshader
!/dist/markti_shaders_mod.hnmod
!/dist/markti_shaders_ultra_mod.hnmod
!/dist/manifest.json
!/dist/SHA256SUMS

# Raw runtime/install reports can contain local paths and session state.
/reports/*
!/reports/README.md
!/reports/validation-*.json
!/reports/loader-*.txt
!/reports/tests-*.txt
!/reports/documentation.json
